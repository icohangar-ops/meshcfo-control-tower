# Nebius Token Factory — required for live Nemotron briefs
# Get a key at https://tokenfactory.nebius.com/
NEBIUS_API_KEY=

# OpenAI-compatible inference endpoint (trailing slash is fine)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA open model on Token Factory (default = Nemotron 3 Nano)
# Prefer: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Also available: nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Optional fallback if the primary model is unavailable
NEBIUS_FALLBACK_MODEL=nvidia/Nemotron-3_5-Lightning

# Signed audit ledger HMAC key. A demo default is used when unset.
# Set a real secret before any non-demo use.
# AUDIT_LEDGER_KEY=

# Optional Tavily key — enriches Why-Now with labeled market context
# (never treated as company-specific EDGAR evidence)
# TAVILY_API_KEY=

# Ledger path (default: .meshcfo/audit.jsonl)
# MESHCFO_LEDGER_PATH=.meshcfo/audit.jsonl
